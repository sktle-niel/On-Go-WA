# Copy to .env for local development. Never commit .env.
# `npm run secrets` prints fresh values for the two secrets below. Paste them in;
# the app refuses to start while they are empty. Never put a real value in this file.

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=debug

# ── Secrets ────────────────────────────────────────────────────────────────
JWT_SIGNING_KEY=
PASSWORD_PEPPER=
# JWT_PREVIOUS_SIGNING_KEY=          # only while rotating JWT_SIGNING_KEY

# ── Database (docker compose defaults) ─────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ongo
PGUSER=ongo
PGPASSWORD=                          # any local value; docker compose creates the database with it
PGSSLMODE=disable                    # production: verify-full + PG_CA_CERT
# PG_CA_CERT=/path/to/rds-ca-bundle.pem
PG_POOL_MAX=10

# ── Redis (optional; required for more than one API instance) ──────────────
# REDIS_URL=redis://localhost:6379

# ── Browser clients (the console). Native mobile apps need no entry. ───────
# Comma-separated exact origins. Empty = allow any origin (development only).
CORS_ALLOWED_ORIGINS=
# Staging only: also accept http://localhost:* so a local Flutter web build
# can talk to a deployed API. Leave unset on the real production service.
# CORS_ALLOW_LOCALHOST=true
# Proxy in front (Cloud Run = 1, ALB = 1, none = 0)? Count the hops so client
# IPs are read correctly for rate limiting and the audit trail.
TRUST_PROXY_HOPS=0

# ── Sessions ───────────────────────────────────────────────────────────────
ACCESS_TOKEN_TTL_SECONDS=600         # 10 min; production caps at 900
REFRESH_TOKEN_TTL_SECONDS=1209600    # 14 days idle
SESSION_ABSOLUTE_TTL_SECONDS=5184000 # 60 days hard limit
REFRESH_COOKIE_NAME=ongo_refresh
REFRESH_COOKIE_SAMESITE=lax          # none (+ REFRESH_COOKIE_DOMAIN) if the console is on another site
# REFRESH_COOKIE_DOMAIN=

# ── Abuse controls ─────────────────────────────────────────────────────────
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_SECONDS=300
LOGIN_MAX_FAILED_ATTEMPTS=8
LOGIN_LOCKOUT_SECONDS=900
PASSWORD_RESET_CODE_TTL_SECONDS=600
PASSWORD_RESET_MAX_ATTEMPTS=5
MAX_REQUEST_BODY_BYTES=262144

# ── Misc ───────────────────────────────────────────────────────────────────
REVENUE_TIMEZONE=Asia/Manila
WS_HEARTBEAT_SECONDS=30
LOAD_SHED_MAX_EVENT_LOOP_DELAY_MS=1000        # 503 while the event loop lags longer; 0 disables
LOAD_SHED_MAX_EVENT_LOOP_UTILIZATION=0.98     # 503 above this utilization; 0 disables
# DOCS_ENABLED=true                  # Swagger UI at /docs; off by default in production
# PUBLIC_BASE_URL=https://api.example.com

# ── AWS (deployed environments only) ───────────────────────────────────────
# AWS_REGION=ap-southeast-1
# APP_SECRETS_ARN=arn:aws:secretsmanager:...   # JSON with JWT_SIGNING_KEY, PASSWORD_PEPPER, ...
# DB_SECRET_ARN=arn:aws:secretsmanager:...    # the RDS-managed credential
